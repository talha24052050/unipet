[sub_resource type="GDScript" id="pet_btn_script"]
script/source = "extends Button

func _ready() -> void:
	pressed.connect(_on_pressed)

func _on_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scenes/ui/pet_select.tscn\")
"

[sub_resource type="GDScript" id="main_script"]
script/source = "extends Node3D

const ChatCatalog := preload(\"res://src/net/chat_catalog.gd\")

var _catalog: RefCounted

@onready var _player: CharacterBody3D = $Player
@onready var _network_sync: Node = get_node_or_null(\"NetworkSync\")


func _ready() -> void:
	_catalog = ChatCatalog.new()
	if Services.net != null:
		Services.net.chat_received.connect(_on_chat_received)


func _on_chat_received(msg: ChatMessage) -> void:
	if msg == null:
		return
	var target: Node3D = _find_player_node(msg.sender_id)
	if target == null:
		return

	match msg.kind:
		ChatMessage.Kind.PRESET:
			var text: String = _catalog.preset_text(msg.payload)
			if text.is_empty():
				return
			var bubble = target.get_node_or_null(\"ChatBubble\")
			if bubble != null and bubble.has_method(\"show_message\"):
				bubble.show_message(text)

		ChatMessage.Kind.EMOTE:
			var anim: StringName = _catalog.emote_anim(msg.payload)
			if anim == &\"\":
				return
			if \"visual\" in target and target.visual != null:
				target.visual.play_emote(anim)

		ChatMessage.Kind.FREE:
			if not Config.FREE_CHAT_ENABLED:
				return
			if msg.payload.is_empty():
				return
			var bubble = target.get_node_or_null(\"ChatBubble\")
			if bubble != null and bubble.has_method(\"show_message\"):
				bubble.show_message(msg.payload)


func _find_player_node(sender_id: String) -> Node3D:
	if Services.net != null and sender_id == Services.net.local_player_id():
		return _player
	if _network_sync != null and _network_sync.has_method(\"get_remote_player\"):
		return _network_sync.get_remote_player(sender_id)
	return null
"

