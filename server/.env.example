# Database (PostgreSQL)
POSTGRES_DB=nakama
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdb

# Nakama
NAKAMA_SERVER_KEY=unipet-dev-server-key
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASS=password

# UniPet sunucu modülü (server/nakama/modules/index.js)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Yerel geliştirme: oyundaki sahte giriş (mock-...) kabul edilsin. Yayında false!
UNIPET_DEV_AUTH=true
UNIPET_ROOM_CAPACITY=40
UNIPET_FREE_CHAT=false
# Sadece @std.yildiz.edu.tr (şimdilik kapalı)
UNIPET_REQUIRE_SCHOOL_EMAIL=false
